{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://facereel.net",
          "https://www.facereel.net"
        ],
        "methods": [
          "GET"
        ],
        "headers": [
          "Range"
        ]
      },
      "exposeHeaders": [
        "Accept-Ranges",
        "Content-Length",
        "Content-Range",
        "Content-Type"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
