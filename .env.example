NODE_ENV=development
APP_URL=http://localhost:3000

# Prisma Postgres: pooled URL at runtime, direct URL only for migrations.
DATABASE_URL=postgresql://facereel:facereel@127.0.0.1:5432/facereel
DIRECT_DATABASE_URL=postgresql://facereel:facereel@127.0.0.1:5432/facereel

# Private Cloudflare R2 bucket. Never prefix these with NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Local development dispatch; use "cloud-tasks" in production.
CLOUD_TASKS_MODE=local
LOCAL_WORKER_URL=http://127.0.0.1:8080
LOCAL_WORKER_SECRET=local-development-only
GOOGLE_CLOUD_PROJECT=facereel-prod
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=facereel-renders
CLOUD_RUN_WORKER_URL=
CLOUD_TASKS_INVOKER_SERVICE_ACCOUNT=facereel-task-invoker@facereel-prod.iam.gserviceaccount.com
CRON_SECRET=

INSTAGRAM_RAPIDAPI_KEY=
INSTAGRAM_RAPIDAPI_HOST=instagram120.p.rapidapi.com
RESEND_API_KEY=
EMAIL_FROM=FaceReel <onboarding@resend.dev>
ADMIN_EMAIL=

FACEAPI_MODEL_DIR=./models/face-api
FACEREEL_MATCH_THRESHOLD=0.5
FACEREEL_MIN_MATCHES=4
FACEREEL_MAX_IMAGES=500
FACEREEL_SCAN_DOWNLOAD_CONCURRENCY=6
FACEREEL_SOURCE_DOWNLOAD_CONCURRENCY=3
FACEREEL_MOCK=0
RENDER_STALE_MINUTES=30
